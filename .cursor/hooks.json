{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-inject-architecture.mjs"
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/session-inject-architecture.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/guard-database-ddl.mjs",
        "matcher": "Write|StrReplace"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-database-ddl.mjs",
        "matcher": "psql"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/guard-database-ddl.mjs",
        "matcher": "run_sql"
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/post-edit-architecture-hints.mjs",
        "matcher": "Write|StrReplace"
      }
    ]
  }
}
