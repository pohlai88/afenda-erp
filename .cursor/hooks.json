{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-inject-architecture.mjs"
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/session-inject-architecture.mjs"
      }
    ],
    "beforeFileEdit": [
      {
        "command": "tsx scripts/validate-feature-shape.mts --path \"${file}\" --action edit",
        "matcher": "packages/features/**|apps/erp/src/**"
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/guard-kernel-boundary-imports.mjs",
        "matcher": "Write|StrReplace",
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/guard-server-boundary-imports.mjs",
        "matcher": "Write|StrReplace"
      },
      {
        "command": "node .cursor/hooks/guard-database-ddl.mjs",
        "matcher": "Write|StrReplace"
      },
      {
        "command": "node .cursor/hooks/guard-architecture-docs.mjs",
        "matcher": "Delete"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-database-ddl.mjs",
        "matcher": "psql"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/guard-database-ddl.mjs",
        "matcher": "run_sql"
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/enforce-architecture-drift.mjs",
        "matcher": "Write|StrReplace",
        "timeout": 300,
        "failClosed": true
      },
      {
        "command": "node .cursor/hooks/post-edit-architecture-hints.mjs",
        "matcher": "Write|StrReplace"
      },
      {
        "command": "tsx scripts/validate-feature-shape.mts --path \"${file}\" --action write",
        "matcher": "packages/features/**|apps/erp/src/**"
      }
    ]
  }
}
