# =============================================================================
# Copy to `.env.config` (gitignored), fill values, then:
#   pnpm env:sync          → `.env.local` + `apps/erp/.env.local`
#   pnpm env:sync:cursor   → Windows User env for Cursor MCP (Windows)
#   pnpm env:sync:all      → both
# Schema reference: `packages/config/src/env.ts`
# =============================================================================

# -----------------------------------------------------------------------------
# A. Public — sent to the browser (NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Afenda
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STAGE=dev
# NEXT_PUBLIC_TENANT_ROOT_DOMAIN=

# -----------------------------------------------------------------------------
# C. Database — Neon + Drizzle
# -----------------------------------------------------------------------------
# NEON_API_KEY — Neon console API key; Cursor Neon MCP (`pnpm env:sync:cursor`)
NEON_API_KEY=
NEON_ORG_ID=
NEON_PROJECT_ID=
NEON_PROJECT_NAME=
NEON_BRANCH_ID=
NEON_BRANCH_NAME=
NEON_DATABASE_NAME=
NEON_DB_ROLE=
NEON_REGION=
NEON_PROXY_HOST=
NEON_PG_VERSION=
DATABASE_URL=

# -----------------------------------------------------------------------------
# C. Database — Neon preview (optional; do not override production DATABASE_URL)
# -----------------------------------------------------------------------------
# `pnpm db:migrate`: DATABASE_MIGRATION_URL → DATABASE_URL → NEON_PREVIEW_DATABASE_URL
DATABASE_MIGRATION_URL=
NEON_PREVIEW_BRANCH_ID=
NEON_PREVIEW_DATABASE_URL=

# -----------------------------------------------------------------------------
# D. Object storage — Vercel Blob (default) or Cloudflare R2
# -----------------------------------------------------------------------------
# Provider: vercel-blob | r2 (auto-detects from credentials when unset)
# OBJECT_STORAGE_PROVIDER=vercel-blob
#
# Vercel Blob — `vercel blob create-store afenda-erp-documents --access private --yes`
# Auto-provisions BLOB_READ_WRITE_TOKEN on linked Vercel projects.
# Local dev callback for onUploadCompleted (optional; use ngrok/cloudflared tunnel):
# VERCEL_BLOB_CALLBACK_URL=https://your-tunnel.example/api/internal/v1/uploads
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_CALLBACK_URL=
#
# Cloudflare R2 (S3-compatible) — set OBJECT_STORAGE_PROVIDER=r2
# OBJECT_STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_BUCKET=your-bucket
# OBJECT_STORAGE_PUBLIC_URL_BASE=https://attachments.nexuscanon.com
# R2_PUBLIC_CUSTOM_DOMAIN=attachments.nexuscanon.com
# CLOUDFLARE_ACCOUNT_ID=c4a3b29bfa877132a1f16c5c628dc8a2  # wrangler.jsonc default
# CLOUDFLARE_ZONE_ID=                         # optional if CLOUDFLARE_API_TOKEN set (SDK auto-resolves apex)
# CLOUDFLARE_API_TOKEN → .secret.config       # R2 + Zone Read; `pnpm r2:cloudflare:verify`
# R2_CORS_EXTRA_ORIGINS=https://www.nexuscanon.com,https://<preview>.vercel.app
# R2 API token → .secret.config: OBJECT_STORAGE_ACCESS_KEY_ID, OBJECT_STORAGE_SECRET_ACCESS_KEY
# Legacy aliases R2_ENDPOINT, R2_BUCKET_NAME, R2_ACCOUNT_ID, R2_ACCESS_KEY_* still work.
# After credentials: pnpm r2:verify · pnpm exec wrangler login · pnpm r2:provision (CORS)
# Omit all OBJECT_STORAGE_* keys until R2 is configured (empty values break env parsing).
CRON_SECRET=

# -----------------------------------------------------------------------------
# E. Observability (server)
# -----------------------------------------------------------------------------
# OTEL_SERVICE_NAME — hardcoded as "afenda-erp" in apps/erp/src/instrumentation.ts; not read from env
# OTEL_SERVICE_NAME=afenda-erp
VERCEL_DRAIN_SECRET=

# Reserved — documented integrations, not yet wired in product code (May 2026)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_CSP_REPORT_URI=

# -----------------------------------------------------------------------------
# F. Neon Auth custom delivery + optional integrations
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Used by packages/auth/src/aut-neon-auth-email-delivery-server.ts for Neon Auth OTP + magic-link delivery.
RESEND_API_KEY=
RESEND_FROM=
ABLY_API_KEY=

# -----------------------------------------------------------------------------
# G. Tooling / CI (not read by Next.js at runtime)
# Turborepo remote cache secrets live in `.secret.config`:
#   TURBO_TOKEN — Vercel → Account Settings → Tokens (or team token)
#   TURBO_TEAM  — Vercel team slug (e.g. jacks-projects-7b3cfe94)
# Local: `pnpm env:sync` → `pnpm turbo:link` → `pnpm env:verify:turbo`
# GitHub Actions: add TURBO_TOKEN + TURBO_TEAM repository secrets.
# -----------------------------------------------------------------------------
VERCEL_TOKEN=
E2E_ORG_ADMIN_EMAIL=
E2E_ORG_ADMIN_PASSWORD=
E2E_ORG_SLUG=
E2E_EMPLOYEE_PORTAL_SLUG=

# -----------------------------------------------------------------------------
# L. Cursor MCP — `pnpm env:sync:cursor` → Windows User env (not Next.js)
# NEON_API_KEY is in section C. Do not commit real values.
# CONTEXT7_API_KEY — optional; ctx7sk… from https://context7.com/dashboard
# GITHUB_TOKEN — optional; PAT only if github MCP uses Bearer auth (OAuth needs no PAT)
# CLOUDFLARE_API_TOKEN — optional; R2 + Zone Read for `pnpm r2:*` SDK scripts (`.secret.config`)
#   Cloudflare MCP plugin uses OAuth; SDK/wrangler scripts need this token separately.
# -----------------------------------------------------------------------------
# CONTEXT7_API_KEY=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# H. Debug / build
# -----------------------------------------------------------------------------
# SKIP_ENV_VALIDATION=1
# GOVERNED_LIST_SURFACE_DIAGNOSTICS=1   — enable governed list surface render diagnostics

# -----------------------------------------------------------------------------
# I. Neon Auth — `@afenda/config` + `@afenda/auth`
# See docs/development/neon-auth.md (branch URLs, trusted origins, verify script).
# -----------------------------------------------------------------------------
# Browser → same-origin proxy (Route Handler). Server → hosted Neon Auth URL.
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/api/auth
# production branch (br-young-term-aobkvd38) — must match DATABASE_URL branch:
# NEON_AUTH_BASE_URL=https://ep-snowy-hat-aof9n5iw.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
# JWKS_URL=https://ep-snowy-hat-aof9n5iw.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
# NEON_BRANCH_ID=br-young-term-aobkvd38
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_SESSION_CACHE_TTL=300
# Server SDK logging: silent | warn (default) | debug
# NEON_AUTH_LOG_LEVEL=warn
AFENDA_NEON_AUTH_ENABLED=0
NEXT_PUBLIC_AFENDA_NEON_AUTH_ENABLED=0
# Neon Auth UI defaults (@afenda/auth/neon-auth/ui) — Google OAuth only; phone OTP off in Neon console.
AFENDA_AUTH_GOOGLE_ENABLED=1
# Dedicated email delivery webhook configured for verification/reset/magic-link delivery.
AFENDA_AUTH_EMAIL_DELIVERY_READY=1
AFENDA_AUTH_EMAIL_OTP_ENABLED=1
AFENDA_AUTH_MAGIC_LINK_ENABLED=1
AFENDA_AUTH_FORGOT_PASSWORD_ENABLED=1
AFENDA_AUTH_EMAIL_VERIFICATION_ENABLED=1
# Console/MCP metadata only — not read by apps/erp or packages/config:
# NEON_AUTH_ENDPOINT_ID= NEON_AUTH_PROJECT_ID= NEON_AUTH_BRANCH_ID= JWKS_URL= NEON_AUTH_WEBHOOK_URL=
# Optional signup gate for Neon `user.before_create` webhook (comma-separated domains):
# NEON_AUTH_WEBHOOK_BLOCKED_EMAIL_DOMAINS=mailinator.com,tempmail.com

# App server flags (`packages/config/src/env.ts` — optional; Zod defaults apply)
AFENDA_APP_NAME=Afenda ERP
# Fast local UI loop (no Neon session, no tenant DB on shell/dashboard): set to 1 while designing UI.
# Use AFENDA_NEON_AUTH_ENABLED=0 together. Run `pnpm env:sync` and restart `pnpm dev`.
AFENDA_DEV_AUTH_BYPASS=0
AFENDA_E2E_DEV_AUTH=0

# -----------------------------------------------------------------------------
# I-bis. Stripe — `@afenda/billing` (org-scoped subscriptions)
# -----------------------------------------------------------------------------
# Dashboard: https://dashboard.stripe.com/apikeys
# Webhook endpoint (local): stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PLAN_KEY=pro
STRIPE_PRICE_HOBBY=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Price ID for the default subscription plan (Stripe Dashboard → Products)
STRIPE_PRICE_ID=

# -----------------------------------------------------------------------------
# J. AI Gateway — `@afenda/ai`
# -----------------------------------------------------------------------------
AFENDA_AI_MODEL=openai/gpt-5.5
AFENDA_AI_FAST_MODEL=
AFENDA_AI_HIGH_CONFIDENCE_MODEL=
RERANK_MODEL=
AI_GATEWAY_API_KEY=
# Vercel account token for management APIs only. Runtime model calls and
# Gateway reporting use AI_GATEWAY_API_KEY or VERCEL_OIDC_TOKEN.
VERCEL_API_TOKEN=
VERCEL_OIDC_TOKEN=

# -----------------------------------------------------------------------------
# K. OpenStatus — reserved, not yet wired (May 2026)
# -----------------------------------------------------------------------------
OPENSTATUS_API_TOKEN=
OPENSTATUS_PUBLIC_STATUS_URL=
OPENSTATUS_STATUS_PAGE_ID=
OPENSTATUS_STATUS_PAGE_SLUG=
OPENSTATUS_WORKSPACE_SLUG=

# -----------------------------------------------------------------------------
# Refactor gate — local only (remove before production)
# -----------------------------------------------------------------------------
AFENDA_I18N_SINGLE_LOCALE=
NEXT_PUBLIC_AFENDA_I18N_SINGLE_LOCALE=
