{
  "name": "@afenda/erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm -C ../.. env:sync",
    "dev": "next dev",
    "build": "next build",
    "analyze": "next experimental-analyze",
    "start": "next start",
    "lint": "pnpm guard:erp && eslint .",
    "guard:src": "tsx ../../scripts/guard-erp-src-layout.mts",
    "guard:app": "tsx ../../scripts/guard-erp-app-layout.mts",
    "guard:kitchen-sinks": "tsx ../../scripts/guard-kitchen-sinks-naming.mts",
    "guard:routes": "tsx ../../scripts/guard-routes-naming.mts",
    "guard:erp": "pnpm guard:src && pnpm guard:app && pnpm guard:kitchen-sinks && pnpm guard:routes",
    "typecheck": "pnpm guard:erp && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config=playwright.config.cjs --grep-invert \"@visual\"",
    "test:e2e:ci": "playwright test --config=playwright.config.cjs",
    "test:e2e:smoke": "playwright test --config=playwright.config.cjs --project=chromium-public-smoke --project=chromium-authenticated-smoke --project=chromium-dev-auth-flow",
    "test:e2e:public": "playwright test --config=playwright.config.cjs --project=chromium-public-smoke",
    "test:e2e:auth": "playwright test --config=playwright.config.cjs --project=chromium-authenticated-smoke",
    "test:e2e:hr": "playwright test --config=playwright.config.cjs --project=chromium-hr-critical",
    "test:e2e:system-admin": "playwright test --config=playwright.config.cjs --project=chromium-system-admin-approvals --project=chromium-system-admin-audit-viewer --project=chromium-system-admin-billing --project=chromium-system-admin-capabilities --project=chromium-system-admin-data-management",
    "test:e2e:neon": "playwright test --config=playwright.config.cjs --project=chromium-neon-smoke",
    "test:e2e:shard": "playwright test --config=playwright.config.cjs --grep-invert \"@visual\"",
    "test:visual": "playwright test --config=playwright.config.cjs --grep \"@visual\"",
    "test:visual:update": "playwright test --config=playwright.visual.config.cjs --grep \"@visual\" --update-snapshots"
  },
  "dependencies": {
    "@afenda/ai": "workspace:*",
    "@afenda/appshell": "workspace:*",
    "@afenda/auth": "workspace:*",
    "@afenda/billing": "workspace:*",
    "@afenda/db": "workspace:*",
    "@afenda/kernel": "workspace:*",
    "@afenda/metadata-ui": "workspace:*",
    "@afenda/feature-crm": "workspace:*",
    "@afenda/feature-dashboard": "workspace:*",
    "@afenda/feature-finance": "workspace:*",
    "@afenda/feature-hr-suite": "workspace:*",
    "@afenda/feature-inventory": "workspace:*",
    "@afenda/feature-knowledge": "workspace:*",
    "@afenda/feature-lynx": "workspace:*",
    "@afenda/feature-purchasing": "workspace:*",
    "@afenda/feature-reports": "workspace:*",
    "@afenda/feature-sales": "workspace:*",
    "@afenda/feature-system-admin": "workspace:*",
    "@afenda/governed-surface": "workspace:*",
    "@afenda/object-storage": "workspace:*",
    "@afenda/observability": "workspace:*",
    "@afenda/public-homepage": "workspace:*",
    "@afenda/ui": "workspace:*",
    "@afenda/workflows": "workspace:*",
    "@ai-sdk/react": "^3.0.193",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^2.4.0",
    "@vercel/otel": "^1.14.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.191",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "catalog:",
    "lucide-react": "^1.16.0",
    "next": "catalog:",
    "radix-ui": "^1.4.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@afenda/config": "workspace:*",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-filename-rules": "^1.3.1",
    "shadcn": "^4.8.1",
    "tailwindcss": "^4",
    "typescript": "catalog:",
    "vitest": "^3.2.4"
  }
}
