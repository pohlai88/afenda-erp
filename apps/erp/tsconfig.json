{
  "extends": "../../packages/config/tsconfig.next.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"],
      "@afenda/ui": ["../../packages/ui/src/index.ts"],
      "@afenda/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/unit/**/*.ts",
    "tests/routes/**/*.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/e2e",
    "playwright.config.cjs",
    "vitest.config.ts"
  ]
}
