{
  "name": "afenda-erp",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "env:sync": "tsx scripts/sync-env.mts",
    "env:verify:gateway": "tsx scripts/verify-ai-gateway-env.mts",
    "ai:verify:gateway-models": "pnpm --filter @afenda/ai verify:gateway-models",
    "env:sync:cursor": "tsx scripts/sync-cursor-env.mts",
    "env:sync:dry-run": "tsx scripts/sync-env.mts --dry-run",
    "env:sync:all": "pnpm env:sync && pnpm env:sync:cursor",
    "predev": "pnpm env:sync",
    "env:verify:turbo": "tsx scripts/verify-turbo-remote-cache.mts",
    "env:sync:github-turbo": "tsx scripts/sync-github-turbo-secrets.mts",
    "turbo:link": "tsx scripts/link-turbo-remote-cache.mts",
    "dev": "tsx scripts/run-turbo.mts dev --filter=@afenda/erp",
    "build": "tsx scripts/run-turbo.mts build",
    "build:affected": "tsx scripts/run-turbo.mts build --affected",
    "lint": "tsx scripts/run-turbo.mts lint",
    "lint:affected": "tsx scripts/run-turbo.mts lint --affected",
    "typecheck": "pnpm typecheck:scripts && tsx scripts/run-turbo.mts typecheck",
    "typecheck:affected": "pnpm typecheck:scripts && tsx scripts/run-turbo.mts typecheck --affected",
    "typecheck:scripts": "tsc -p tsconfig.json --noEmit",
    "architecture:check": "tsx scripts/check-directory-architecture.mts && tsx scripts/check-kernel-boundary.mts && tsx packages/db/scripts/check-drizzle-journal.mts && tsx packages/features/hr-suite/scripts/check-hr-feature-vertical-naming.mts && pnpm design-system:check",
    "design-system:check": "pnpm audit:tailwind-token-parity && pnpm audit:shadcn-primitives && pnpm audit:governed-design-tokens --scope=all --strict && pnpm audit:shadcn-composition --strict",
    "audit:tailwind-token-parity": "tsx packages/ui/scripts/check-tailwind-token-parity.mts",
    "audit:shadcn-primitives": "tsx packages/ui/scripts/check-shadcn-primitive-boundary.mts",
    "audit:shadcn-upstream:sync": "tsx packages/ui/scripts/sync-shadcn-upstream-manifest.mts",
    "kernel:check": "tsx scripts/check-kernel-boundary.mts",
    "system-admin:scorecard-audit": "tsx scripts/system-admin-scorecard-audit.mts",
    "artifacts:init": "tsx scripts/ensure-artifacts-layout.mts",
    "artifacts:check": "tsx scripts/check-artifacts-layout.mts",
    "artifacts:clean": "tsx scripts/clean-artifacts.mts",
    "artifacts:reset": "pnpm artifacts:clean && pnpm artifacts:init",
    "pretest": "pnpm artifacts:init",
    "pretest:all": "pnpm artifacts:init",
    "pretest:packages": "pnpm artifacts:init",
    "pretest:e2e": "pnpm artifacts:init",
    "pretest:integration": "pnpm artifacts:init",
    "test": "pnpm test:unit",
    "test:unit": "tsx scripts/run-turbo.mts test --filter=./packages/* --filter=./packages/features/* --filter=@afenda/erp",
    "test:integration": "tsx scripts/run-turbo.mts test:integration --filter=@afenda/feature-hr-suite",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:packages": "pnpm test:unit",
    "test:affected": "tsx scripts/run-turbo.mts test --affected --filter=./packages/* --filter=./packages/features/* --filter=@afenda/erp",
    "test:affected:all": "pnpm test:affected && pnpm test:integration",
    "ci:turbo": "tsx scripts/run-turbo.mts run typecheck lint test test:integration build //#format //#performance:budget",
    "ci:turbo:affected": "tsx scripts/run-turbo.mts run typecheck lint test test:integration build //#format //#performance:budget --affected",
    "test:e2e": "pnpm artifacts:init && pnpm --filter @afenda/erp build && pnpm --filter @afenda/erp test:e2e",
    "test:e2e:ci": "pnpm artifacts:init && pnpm --filter @afenda/erp build && pnpm --filter @afenda/erp test:e2e:ci",
    "test:e2e:smoke": "pnpm artifacts:init && pnpm --filter @afenda/erp build && pnpm --filter @afenda/erp test:e2e:smoke",
    "test:e2e:public": "pnpm artifacts:init && pnpm --filter @afenda/erp build && pnpm --filter @afenda/erp test:e2e:public",
    "test:e2e:auth": "pnpm artifacts:init && pnpm --filter @afenda/erp build && pnpm --filter @afenda/erp test:e2e:auth",
    "test:e2e:hr": "pnpm artifacts:init && pnpm --filter @afenda/erp build && pnpm --filter @afenda/erp test:e2e:hr",
    "test:e2e:neon": "pnpm artifacts:init && pnpm --filter @afenda/erp build && pnpm --filter @afenda/erp test:e2e:neon",
    "test:e2e:shard": "pnpm artifacts:init && pnpm --filter @afenda/erp build && pnpm --filter @afenda/erp test:e2e:shard",
    "test:visual": "pnpm --filter @afenda/erp test:visual",
    "test:visual:update": "pnpm --filter @afenda/erp test:visual:update",
    "analyze:erp": "pnpm --filter @afenda/erp analyze",
    "performance:budget": "tsx scripts/check-performance-budget.mts",
    "security:review": "tsx scripts/security-review.mts",
    "lint:governed-renderers": "tsx packages/governed-surface/scripts/lint-governed-renderers.mts",
    "lint:governed-trailing-cells": "tsx packages/governed-surface/scripts/lint-governed-trailing-cells.mts",
    "lint:governed-renderer-contracts": "tsx packages/governed-surface/scripts/check-renderer-contracts.mts",
    "audit:governed-design-tokens": "tsx packages/governed-surface/scripts/audit-design-system-tokens.mts",
    "audit:shadcn-composition": "tsx packages/governed-surface/scripts/audit-shadcn-composition.mts",
    "audit:skeleton-parity": "tsx packages/governed-surface/scripts/audit-streaming-skeleton-parity.mts --strict",
    "audit:list-surface-chrome": "tsx packages/governed-surface/scripts/audit-list-surface-chrome.mts --strict",
    "lint:lynx-brand": "tsx scripts/lint-lynx-brand.mts",
    "scaffold:feature": "tsx packages/_template-definition/scripts/scaffold-feature.mts",
    "scaffold:vertical": "tsx packages/_template-definition/scripts/scaffold-vertical.mts",
    "scaffold:hr-slice": "pnpm --filter @afenda/feature-hr-suite scaffold:hr-slice",
    "validate:feature-shape": "tsx packages/_template-definition/scripts/validate-feature-shape.mts",
    "validate:feature-entry": "tsx packages/_template-definition/scripts/validate-feature-entry.mts",
    "knip": "knip",
    "knip:ci": "knip --include dependencies,unresolved --no-progress",
    "db:generate": "tsx scripts/run-turbo.mts db:generate --filter=@afenda/db",
    "db:migrate": "tsx scripts/run-turbo.mts db:migrate --filter=@afenda/db",
    "db:seed": "tsx scripts/run-turbo.mts db:seed --filter=@afenda/db",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "stripe:configure": "tsx scripts/configure-stripe-local.mts",
    "stripe:setup": "tsx scripts/setup-stripe-integration.mts",
    "stripe:evaluate": "tsx scripts/evaluate-stripe-secrets.mts",
    "stripe:test": "tsx scripts/test-stripe-integration.mts",
    "stripe:status": "tsx scripts/stripe-status.mts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed,invoice.finalized",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "knip": "^5.67.2",
    "prettier": "^3.6.2",
    "turbo": "^2.8.3",
    "typescript": "catalog:"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.22.3"
  }
}
