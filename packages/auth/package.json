{
  "name": "@afenda/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./auth-flows": {
      "types": "./src/contracts/auth.flows.ts",
      "development": "./src/contracts/auth.flows.ts",
      "default": "./dist/contracts/auth.flows.js"
    }
  },
  "dependencies": {
    "@afenda/config": "workspace:*",
    "@afenda/db": "workspace:*",
    "@afenda/kernel": "workspace:*",
    "@afenda/neon-auth": "workspace:*",
    "@afenda/observability": "workspace:*",
    "@afenda/ui": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "server-only": "^0.0.1",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
