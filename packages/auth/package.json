{
  "name": "@afenda/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./neon-auth": {
      "types": "./src/aut-neon-compat-index.ts",
      "development": "./src/aut-neon-compat-index.ts",
      "default": "./dist/aut-neon-compat-index.js"
    },
    "./neon-auth/server": {
      "types": "./src/aut-neon-compat-server.ts",
      "development": "./src/aut-neon-compat-server.ts",
      "default": "./dist/aut-neon-compat-server.js"
    },
    "./neon-auth/client": {
      "types": "./src/neon-auth/client.ts",
      "development": "./src/neon-auth/client.ts",
      "default": "./dist/neon-auth/client.js"
    },
    "./neon-auth/neon-cookies": {
      "types": "./src/aut-neon-cookies-shared.ts",
      "development": "./src/aut-neon-cookies-shared.ts",
      "default": "./dist/aut-neon-cookies-shared.js"
    },
    "./neon-auth/neon-session": {
      "types": "./src/aut-neon-session-server.ts",
      "development": "./src/aut-neon-session-server.ts",
      "default": "./dist/aut-neon-session-server.js"
    },
    "./neon-auth/paths": {
      "types": "./src/aut-paths-shared.ts",
      "development": "./src/aut-paths-shared.ts",
      "default": "./dist/aut-paths-shared.js"
    },
    "./neon-auth/ui": {
      "types": "./src/aut-neon-compat-ui.ts",
      "development": "./src/aut-neon-compat-ui.ts",
      "default": "./dist/aut-neon-compat-ui.js"
    },
    "./neon-auth/pages": {
      "types": "./src/aut-neon-compat-pages.ts",
      "development": "./src/aut-neon-compat-pages.ts",
      "default": "./dist/aut-neon-compat-pages.js"
    }
  },
  "dependencies": {
    "@afenda/config": "workspace:*",
    "@neondatabase/auth": "0.4.1-beta",
    "@neondatabase/auth-ui": "0.2.0-beta",
    "jose": "^6.1.2",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@afenda/config": "workspace:*",
    "server-only": "^0.0.1",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
