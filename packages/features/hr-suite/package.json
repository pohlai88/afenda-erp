{
  "name": "@afenda/feature-hr-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./metadata": {
      "types": "./src/metadata.ts",
      "development": "./src/metadata.ts",
      "default": "./dist/metadata.js"
    }
  },
  "dependencies": {
    "@afenda/auth": "workspace:*",
    "@afenda/db": "workspace:*",
    "@afenda/governed-surface": "workspace:*",
    "@afenda/kernel": "workspace:*",
    "@afenda/ui": "workspace:*",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check:vertical-naming": "tsx scripts/check-hr-feature-vertical-naming.mts",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@afenda/config": "workspace:*",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  }
}
