{
  "name": "@afenda/governed-surface",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./metadata": {
      "types": "./src/metadata/index.ts",
      "development": "./src/metadata/index.ts",
      "default": "./dist/metadata/index.js"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "development": "./src/schemas/index.ts",
      "default": "./dist/schemas/index.js"
    }
  },
  "dependencies": {
    "@afenda/auth": "workspace:*",
    "@afenda/ui": "workspace:*",
    "@number-flow/react": "^0.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.25",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@afenda/config": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
