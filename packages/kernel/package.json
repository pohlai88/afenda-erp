{
  "name": "@afenda/kernel",
  "version": "0.1.0",
  "description": "Execution law (active: execution-kernel/) and frozen generic ERP compat. See ARCH-1002.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./execution": {
      "types": "./src/execution.ts",
      "development": "./src/execution.ts",
      "import": "./src/execution.ts",
      "default": "./dist/execution.js"
    },
    "./execution-capabilities": {
      "types": "./src/execution-kernel/capabilities/execution-capabilities.ts",
      "development": "./src/execution-kernel/capabilities/execution-capabilities.ts",
      "import": "./src/execution-kernel/capabilities/execution-capabilities.ts",
      "default": "./dist/execution-kernel/capabilities/execution-capabilities.js"
    },
    "./feature-metadata": {
      "types": "./src/modules/feature-metadata.ts",
      "development": "./src/modules/feature-metadata.ts",
      "import": "./src/modules/feature-metadata.ts",
      "default": "./dist/modules/feature-metadata.js"
    },
    "./execution-tenant-policy": {
      "types": "./src/execution-kernel/policy/tenant-execution-rules.ts",
      "development": "./src/execution-kernel/policy/tenant-execution-rules.ts",
      "import": "./src/execution-kernel/policy/tenant-execution-rules.ts",
      "default": "./dist/execution-kernel/policy/tenant-execution-rules.js"
    },
    "./module-definitions": {
      "types": "./src/modules/definitions.ts",
      "development": "./src/modules/definitions.ts",
      "import": "./src/modules/definitions.ts",
      "default": "./dist/modules/definitions.js"
    },
    "./tenant-availability": {
      "types": "./src/modules/tenant-availability.ts",
      "development": "./src/modules/tenant-availability.ts",
      "import": "./src/modules/tenant-availability.ts",
      "default": "./dist/modules/tenant-availability.js"
    },
    "./tenant-module-availability": {
      "types": "./src/modules/tenant-module-availability.ts",
      "development": "./src/modules/tenant-module-availability.ts",
      "import": "./src/modules/tenant-module-availability.ts",
      "default": "./dist/modules/tenant-module-availability.js"
    }
  },
  "dependencies": {
    "@afenda/auth": "workspace:*",
    "@afenda/config": "workspace:*",
    "@afenda/db": "workspace:*",
    "@afenda/governed-surface": "workspace:*",
    "@afenda/observability": "workspace:*",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "sideEffects": false
}
