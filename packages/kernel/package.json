{
  "name": "@afenda/kernel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./execution": {
      "types": "./src/execution.ts",
      "development": "./src/execution.ts",
      "import": "./src/execution.ts",
      "default": "./dist/execution.js"
    },
    "./execution-capabilities": {
      "types": "./src/execution-kernel/capabilities/execution-capabilities.ts",
      "development": "./src/execution-kernel/capabilities/execution-capabilities.ts",
      "import": "./src/execution-kernel/capabilities/execution-capabilities.ts",
      "default": "./dist/execution-kernel/capabilities/execution-capabilities.js"
    },
    "./execution-tenant-policy": {
      "types": "./src/execution-kernel/policy/tenant-execution-rules.ts",
      "development": "./src/execution-kernel/policy/tenant-execution-rules.ts",
      "import": "./src/execution-kernel/policy/tenant-execution-rules.ts",
      "default": "./dist/execution-kernel/policy/tenant-execution-rules.js"
    }
  },
  "dependencies": {
    "@afenda/auth": "workspace:*",
    "@afenda/config": "workspace:*",
    "@afenda/db": "workspace:*",
    "@afenda/governed-surface": "workspace:*",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "catalog:"
  }
}
