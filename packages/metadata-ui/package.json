{
  "name": "@afenda/metadata-ui",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "afenda": {
    "layout": "metadata-ui-runtime"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "certify:visual": "tsx scripts/capture-visual-certification.mts",
    "guard:naming": "tsx scripts/guard-naming.mts",
    "lint": "pnpm guard:naming && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "dependencies": {
    "@afenda/ui": "workspace:*",
    "@number-flow/react": "^0.6.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "motion": "^12.40.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@afenda/config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@playwright/test": "^1.55.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
