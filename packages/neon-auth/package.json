{
  "name": "@afenda/neon-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./neon-cookies": {
      "types": "./src/runtime/neon-cookies.shared.ts",
      "development": "./src/runtime/neon-cookies.shared.ts",
      "default": "./dist/runtime/neon-cookies.shared.js"
    },
    "./neon-session": {
      "types": "./src/runtime/neon-session.server.ts",
      "development": "./src/runtime/neon-session.server.ts",
      "default": "./dist/runtime/neon-session.server.js"
    },
    "./paths": {
      "types": "./src/contracts/paths.shared.ts",
      "development": "./src/contracts/paths.shared.ts",
      "default": "./dist/contracts/paths.shared.js"
    }
  },
  "dependencies": {
    "@afenda/config": "workspace:*",
    "@neondatabase/auth": "0.4.1-beta",
    "jose": "^6.1.2",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "sideEffects": false
}
