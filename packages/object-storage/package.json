{
  "name": "@afenda/object-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "development": "./src/client.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./metadata": {
      "types": "./src/metadata.ts",
      "development": "./src/metadata.ts",
      "default": "./dist/metadata.js"
    }
  },
  "dependencies": {
    "@afenda/auth": "workspace:*",
    "@afenda/config": "workspace:*",
    "@afenda/kernel": "workspace:*",
    "@afenda/observability": "workspace:*",
    "@aws-sdk/client-kms": "^3.888.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/s3-request-presigner": "^3.888.0",
    "@vercel/blob": "^2.4.0",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "layout:check": "tsx scripts/check-object-storage-layout.mts",
    "verify:env": "tsx scripts/verify-object-storage-env.mts",
    "r2:verify:s3-api": "tsx scripts/verify-r2-s3-api.mts",
    "r2:verify:presign": "tsx scripts/verify-r2-presign.mts",
    "r2:verify": "pnpm verify:env && pnpm r2:verify:presign",
    "r2:provision": "tsx scripts/r2-provision.mts",
    "r2:domain:provision": "tsx scripts/r2-domain-provision.mts",
    "r2:cloudflare:verify": "tsx scripts/verify-cloudflare-sdk.mts",
    "r2:status": "tsx scripts/r2-cloudflare-status.mts",
    "blob:migrate:r2": "tsx scripts/migrate-vercel-blob-to-r2.mts",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "sideEffects": false,
  "afenda": {
    "layout": "tiered-feature",
    "tiered": {
      "featureDomains": ["blob", "r2", "s3", "_object-storage-integration"]
    }
  }
}
