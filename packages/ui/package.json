{
  "name": "@afenda/ui",
  "version": "0.1.0",
  "description": "Afenda shadcn fork — see shadcn-update.md after imports; COMPOSITION.md for SectionPanel vs Card",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./design-system": {
      "types": "./src/design-system.ts",
      "development": "./src/design-system.ts",
      "import": "./src/design-system.ts",
      "default": "./dist/design-system.js"
    },
    "./utils": {
      "types": "./src/utils.ts",
      "development": "./src/utils.ts",
      "import": "./src/utils.ts",
      "default": "./dist/utils.js"
    },
    "./use-hydrated.client": {
      "types": "./src/use-hydrated.client.ts",
      "development": "./src/use-hydrated.client.ts",
      "import": "./src/use-hydrated.client.ts",
      "default": "./dist/use-hydrated.client.js"
    },
    "./*": {
      "types": "./src/*.tsx",
      "development": "./src/*.tsx",
      "import": "./src/*.tsx",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretypecheck": "pnpm -w audit:shadcn-primitives",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@radix-ui/react-presence": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-resizable-panels": "^4.11.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@afenda/config": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:",
    "jsdom": "^26.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": false
}
