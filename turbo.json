{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "package.json",
    "packages/config/tsconfig.base.json",
    "packages/config/tsconfig.build.base.json",
    "packages/config/tsconfig.check.base.json",
    ".env.config",
    ".secret.config"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "NEON_PREVIEW_DATABASE_URL",
    "AFENDA_APP_NAME",
    "AFENDA_DEV_AUTH_BYPASS",
    "AFENDA_NEON_AUTH_ENABLED",
    "AFENDA_E2E_DEV_AUTH",
    "NEON_AUTH_BASE_URL",
    "NEON_AUTH_COOKIE_SECRET",
    "CRON_SECRET",
    "VERCEL_DRAIN_SECRET",
    "AI_GATEWAY_API_KEY",
    "VERCEL_OIDC_TOKEN",
    "VERCEL_ENV",
    "VERCEL_BLOB_CALLBACK_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_PRICE_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "NEXT_PUBLIC_APP_NAME",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STAGE",
        "NEXT_PUBLIC_AUTH_URL"
      ]
    },
    "@afenda/erp#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_APP_NAME",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STAGE",
        "NEXT_PUBLIC_AUTH_URL",
        "NEXT_PUBLIC_AFENDA_NEON_AUTH_ENABLED",
        "NEXT_PUBLIC_AFENDA_I18N_SINGLE_LOCALE",
        "VERCEL_URL",
        "DATABASE_URL",
        "CRON_SECRET",
        "VERCEL_DRAIN_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "VERCEL_BLOB_CALLBACK_URL",
        "AI_GATEWAY_API_KEY",
        "VERCEL_OIDC_TOKEN",
        "AFENDA_NEON_AUTH_ENABLED",
        "NEON_AUTH_BASE_URL",
        "NEON_AUTH_COOKIE_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json", "tsconfig.*.json"]
    },
    "//#typecheck:scripts": {
      "inputs": [
        "scripts/**/*.mts",
        "scripts/**/*.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": []
    },
    "//#format": {
      "inputs": [
        "**/*.{ts,tsx,js,mjs,cjs,json,md,mdx,css,yml,yaml}",
        "!**/.next/**",
        "!**/dist/**",
        "!**/.artifacts/**",
        "!**/pnpm-lock.yaml"
      ],
      "outputs": []
    },
    "//#architecture:check": {
      "cache": false
    },
    "//#performance:budget": {
      "dependsOn": ["@afenda/erp#build"],
      "cache": false
    },
    "//#knip:ci": {
      "cache": false,
      "inputs": ["knip.json", "packages/**", "apps/**", "pnpm-workspace.yaml"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "tests/**",
        "src/**",
        "vitest.config.ts",
        "scripts/**/*.mts"
      ],
      "outputs": [".artifacts/coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_MIGRATION_URL",
        "NEON_PREVIEW_DATABASE_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": ["@afenda/erp#build"],
      "cache": false,
      "env": [
        "PLAYWRIGHT_BASE_URL",
        "AFENDA_DEV_AUTH_BYPASS",
        "AFENDA_NEON_AUTH_ENABLED",
        "AFENDA_E2E_DEV_AUTH",
        "NEXT_PUBLIC_APP_NAME",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_STAGE"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_MIGRATION_URL",
        "NEON_PREVIEW_DATABASE_URL"
      ]
    },
    "db:seed": {
      "cache": false,
      "env": ["DATABASE_URL"]
    }
  }
}
