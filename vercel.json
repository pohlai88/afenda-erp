{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm turbo build --filter=@afenda/erp --concurrency=2",
  "crons": [
    {
      "path": "/api/internal/v1/cron/reminders",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/v1/cron/syncs",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/internal/v1/cron/housekeeping",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/v1/cron/lynx-outcomes",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/v1/cron/knowledge-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/internal/v1/cron/document-retention-sweep",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/internal/v1/cron/document-scan-sweep",
      "schedule": "*/30 * * * *"
    }
  ]
}
